#!/usr/bin/env python3
"""Check that a prose edit to a Marimo report kept every template expression.

Report prose lives in `mo.md(rf"...")` strings, where `{...}` expressions are
computed when the notebook runs. An edit that replaces one with the number it
happened to render looks fine and is silently wrong: the report stops tracking
its data.

Two checks, both mechanical:

1. The file parses. Python compiles f-strings, so a dropped brace, a stray
   brace, or an undoubled LaTeX brace is a SyntaxError rather than a surprise
   at render time.
2. Every expression that was there before is still there.

Usage:
    check-templates docs/pipeline/report.py               # against git HEAD
    check-templates report.py --against /tmp/before.py    # against a copy

Exits non-zero if anything was lost, so it can gate a workflow. Added
expressions are reported but do not fail: a rewrite may legitimately introduce
one, and that is for a human to read.
"""

from __future__ import annotations

import argparse
import ast
import re
import subprocess
import sys
from collections import Counter
from pathlib import Path

# A braced expression, skipping the doubled braces that carry literal LaTeX.
EXPR = re.compile(r"(?<!\{)\{([^{}\n]+)\}(?!\})")


def expressions(source: str) -> Counter[str]:
    return Counter(EXPR.findall(source))


def parses(source: str, label: str) -> bool:
    try:
        ast.parse(source)
    except SyntaxError as exc:
        print(f"FAIL  {label} does not parse: {exc.msg} (line {exc.lineno})")
        return False
    return True


def baseline(path: Path, against: str | None) -> str:
    if against:
        return Path(against).read_text()
    show = subprocess.run(
        ["git", "show", f"HEAD:./{path.name}"],
        capture_output=True,
        text=True,
        cwd=path.resolve().parent,
    )
    if show.returncode:
        sys.exit(f"cannot read {path} at HEAD ({show.stderr.strip()}); pass --against instead")
    return show.stdout


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("path", type=Path)
    ap.add_argument("--against", help="file to compare against (default: git HEAD)")
    args = ap.parse_args()

    now = args.path.read_text()
    before = baseline(args.path, args.against)

    if not parses(now, str(args.path)):
        return 1

    a, b = expressions(before), expressions(now)
    lost, added = a - b, b - a

    print(f"{args.path}: {sum(a.values())} expressions -> {sum(b.values())}")
    for expr in sorted(lost.elements()):
        print(f"  LOST  {{{expr}}}")
    for expr in sorted(added.elements()):
        print(f"  new   {{{expr}}}")

    if lost:
        print(
            f"\n{sum(lost.values())} expression(s) gone. Deleting a sentence "
            "takes its expressions with it, which is fine; check that none of "
            "these became a hardcoded number instead."
        )
        return 1
    print("no expressions lost")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
