.DS_Store
.venv/
__pycache__/
*.pyc
*.pyo
.ruff_cache
.vulture-cache
.install.sh.rc
_site/
# Exported report bundles (index.html + named-keyed _assets/). Durable home is the
# HF bucket (synced by `./go publish`); regenerated on export, never committed. They
# live under .mini/exports (covered by the .mini/ rule below); the legacy __marimo__
# scratch dir stays ignored in case a tool writes there.
**/__marimo__/
lightning_logs/
wandb/
scratch*
.mini/

.claude/settings.local.json
# Per-checkout `[tool.mini]` overrides (bucket, publish repo, and any
# `[tool.mini.profiles.<name>]` dev pair). Same keys as pyproject.toml, overlaid
# on it; for settings that shouldn't travel with the repo — see `mini.store.LOCAL_CONFIG`.
mini.local.toml
node_modules/
.claude/worktrees/

# Host time zone captured by .devcontainer/host-timezone.sh at container start.
.devcontainer/.host-tz
